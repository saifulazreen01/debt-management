generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum DebtCategory {
  CREDIT_CARD
  PERSONAL_LOAN
  BNPL
  CAR_LOAN
  HOUSE_LOAN
  OTHER
}

enum InvestmentCategory {
  MEDICAL_CARD
  FIXED_DEPOSIT
  ASB
  TABUNG_HAJI
  OTHER
}

enum InterestType {
  FIXED
  VARIABLE
}

enum InvestmentContributionType {
  NONE
  FIXED
  PERCENTAGE
}

enum IncomeCategory {
  SALARY
  OTHER
  LEASING
}

enum AssetCategory {
  VEHICLE
  PROPERTY
  ELECTRONICS
  JEWELRY
  FURNITURE
  OTHER
}

model Debt {
  id             String        @id @default(cuid())
  name           String
  category       DebtCategory  @default(OTHER)
  loanAmount     Float
  monthlyPayment Float
  fee            Float         @default(0)
  interestRate   Float?
  interestType   InterestType?
  paymentDueDay  Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model FinanceProfile {
  id            Int      @id @default(1)
  monthlySalary Float    @default(0)
  otherIncome   Float    @default(0)
  updatedAt     DateTime @updatedAt
}

model LeasingIncome {
  id            String   @id @default(cuid())
  name          String
  monthlyAmount Float
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Income {
  id            String         @id @default(cuid())
  name          String
  category      IncomeCategory
  monthlyAmount Float
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Investment {
  id                 String                       @id @default(cuid())
  name               String
  category           InvestmentCategory           @default(OTHER)
  amount             Float
  contributionType   InvestmentContributionType   @default(NONE)
  contributionValue  Float?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
}

model Asset {
  id            String        @id @default(cuid())
  name          String
  category      AssetCategory @default(OTHER)
  purchasePrice Float
  purchaseYear  Int
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  yearValues    AssetYearValue[]
}

model AssetYearValue {
  id        String   @id @default(cuid())
  assetId   String
  year      Int
  worth     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, year])
  @@index([year])
}
